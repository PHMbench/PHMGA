# -------------------------------
# PHMGA environment configuration
# -------------------------------
#
# Copy to `.env` and fill values.
#
# NOTE: Do NOT commit your real `.env` to git.

# Disable LangSmith (recommended for local runs)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Choose LLM provider:
# - gemini (default)
# - openai_compatible (any OpenAI-compatible gateway)
# - deepseek (OpenAI-compatible)
# - glm (OpenAI-compatible)
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=

# --- OpenAI-compatible (generic) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- DeepSeek (OpenAI-compatible) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=

# --- GLM/Zhipu (OpenAI-compatible) ---
# GLM_API_KEY=
# GLM_API_BASE=

# Optional: override default model names used by agents (matches src/configuration.py fields)
# PHM_MODEL=
# QUERY_GENERATOR_MODEL=
# REFLECTION_MODEL=
# ANSWER_MODEL=

# Artifact base dir (optional)
# PHM_SAVE_DIR=./save

